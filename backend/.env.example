# StudIQ Backend Environment Variables
# Copy to .env or configure in Render Dashboard

# JWT Secret Key
SECRET_KEY=studiq_production_secret_key_super_secure_987654321

# Allowed CORS origins (comma-separated list of origins)
# Example: ALLOWED_ORIGINS=https://studiq-frontend.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*

# Database Connection URL (Local default vs Render Persistent Disk)
# Local: sqlite:///./studiq.db
# Render Persistent Disk: sqlite:////var/data/studiq.db
STUDIQ_DATABASE_URL=sqlite:///./studiq.db

# HTTP Server Port (Assigned automatically by Render via $PORT)
PORT=8000
