# StudIQ Desktop Monitoring Agent Environment Variables
# Configure on Windows client machine before running python agent.py

# Backend Server URL (Local vs Render Production)
# Local: STUDIQ_BACKEND_URL=http://localhost:8000
# Production: STUDIQ_BACKEND_URL=https://studiq-backend.onrender.com
STUDIQ_BACKEND_URL=http://localhost:8000

# Student ID & Identifier Code
STUDIQ_STUDENT_ID=1
STUDIQ_STUDENT_CODE=STU-2026-001
