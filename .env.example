# StudIQ Production Environment Template (.env.example)
# Rename to .env in production and supply real secrets. Do NOT commit real secrets to Git.

# Environment Mode (development | production)
STUDIQ_ENV=production

# Mandatory Secret Key (MUST be set in production)
SECRET_KEY=replace_with_a_secure_random_64_character_string

# Database Connection String
# SQLite (default for single-institution pilot):
STUDIQ_DATABASE_URL=sqlite:///./studiq.db
# PostgreSQL (recommended for enterprise scale):
# STUDIQ_DATABASE_URL=postgresql://studiq_user:secure_password@localhost:5432/studiq_db

# Allowed CORS Origins (comma-separated list of deployed frontend URLs)
ALLOWED_ORIGINS=https://studiq.yourdomain.com,https://studiq-frontend.onrender.com

# Server Binding
HOST=0.0.0.0
PORT=8000
